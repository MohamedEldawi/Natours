<main class="main">
  <div class="container">
    <h2 class="heading-secondary ma-bt-lg">Manage Tours</h2>
    <h2 class="heading-secondary ma-bt-lg">Manage Tours</h2>

    <div class="add-tour-ui">
      <a href="/Add-Tour" class="btn btn--green add-tour-ui__btn">
        <span class="add-tour-ui__icon">+</span>
        <span class="add-tour-ui__text">Add New Tour</span>
      </a>
    </div>


    <div class="admin-tour-list">

      <% tours.forEach(tour=> { %>
        <div class="admin-tour-row">
          <img src="/img/tours/<%= tour.imageCover  %>" alt="<%= tour.name  %>" class="admin-tour-img" />

          <h3 class="admin-tour-title">
            <%= tour.name %>
          </h3>

          <div class="admin-tour-actions">
            <a class="btn btn--green btn--small" href="#">Edit</a>
            <button class="btn btn--danger btn--small" type="button" data-tour-id="<%= tour.id  %>">Delete</button>
          </div>
        </div>
        <% }) %>
    </div>
  </div>
  <div class="modal hidden" id="confirmModal">
    <div class="modal__overlay"></div>

    <div class="modal__content">
      <h3 class="modal__title">Delete Tour</h3>
      <p class="modal__text">
        Are you sure you want to delete this tour? This action cannot be undone.
      </p>

      <div class="modal__actions">
        <button class="btn btn--secondary" type="button" id="cancelDelete">
          Cancel
        </button>

        <button class="btn btn--danger" type="button" id="confirmDelete">
          Yes, Delete
        </button>
      </div>
    </div>
  </div>

</main>